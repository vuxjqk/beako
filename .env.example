POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Host "db" is the docker compose service name
DATABASE_URL=postgresql+psycopg://<user>:<password>@db:5432/<database>

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# Set true in production (HTTPS)
COOKIE_SECURE=false
