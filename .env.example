POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Host "db" is the docker compose service name
DATABASE_URL=postgresql+psycopg://<user>:<password>@db:5432/<database>

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# Set true in production (HTTPS)
COOKIE_SECURE=false
# HMAC key for OTP codes, generate the same way as JWT_SECRET_KEY
OTP_SECRET_KEY=

# Leave empty in dev: emails are logged to console instead of sent
RESEND_API_KEY=
MAIL_FROM=Beako <onboarding@resend.dev>

# OAuth client ID(s) from Google Cloud Console, comma-separated if several
GOOGLE_CLIENT_ID=

# Used to build links in emails (e.g. invitation)
FRONTEND_URL=http://localhost:3000

# Local file storage (avatars, ...)
MEDIA_ROOT=media
MEDIA_URL=http://localhost:8000/media
